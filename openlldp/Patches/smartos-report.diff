+#ifndef WIN32
+/*
+ * Any local user can connect to the neighbor socket, and lldpd serves the
+ * clients in its main loop.  A client that does not read must not stop LLDP,
+ * thus the reply has one deadline for the whole send, not one per send().
+ */
+#define	LLDP_CLIENT_TIMEOUT_SEC	2
+
+/*
+ * Returns -1 if the client went away, or did not read the whole reply
+ * before the deadline.
+ */
+static int
+lldp_send_all(int sd, const char *buf, size_t len)
+{
+	struct timespec now, deadline;
+	struct pollfd pfd;
+	ssize_t n;
+	long ms;
+	int flags;
+
+	if ((flags = fcntl(sd, F_GETFL)) < 0 ||
+	    fcntl(sd, F_SETFL, flags | O_NONBLOCK) < 0)
+		return (-1);
+
+	(void) clock_gettime(CLOCK_MONOTONIC, &deadline);
+	deadline.tv_sec += LLDP_CLIENT_TIMEOUT_SEC;
+
+	pfd.fd = sd;
+	pfd.events = POLLOUT;
+
+	while (len > 0) {
+		(void) clock_gettime(CLOCK_MONOTONIC, &now);
+		ms = (deadline.tv_sec - now.tv_sec) * 1000 +
+		    (deadline.tv_nsec - now.tv_nsec) / 1000000;
+		if (ms <= 0) {
+			errno = ETIMEDOUT;
+			return (-1);
+		}
+
+		if ((n = send(sd, buf, len, 0)) >= 0) {
+			buf += n;
+			len -= n;
+			continue;
+		}
+
+		if (errno == EINTR)
+			continue;
+		if (errno != EAGAIN && errno != EWOULDBLOCK)
+			return (-1);
+
+		if (poll(&pfd, 1, (int)ms) < 0 && errno != EINTR)
+			return (-1);
+	}
+
+	return (0);
+}
+#endif /* WIN32 */
 
