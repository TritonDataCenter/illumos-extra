+/*
+ * A physical link that is a member of an aggregation cannot be opened with
+ * DLPI, thus LLDP runs on the aggregation and not on its members.  The
+ * aggregations are walked first to collect the member link ids, then the
+ * physical links are walked and the members are skipped.
+ */
+typedef struct lldp_dl_walk {
+	int		ldw_nlinks;
+	datalink_id_t	*ldw_members;
+	uint_t		ldw_nmembers;
+	uint_t		ldw_alloc;
+} lldp_dl_walk_t;
 
-	if ((err = dladm_datalink_id2info(dah, id, &flags, &class, &media,
-	    link, MAXLINKNAMELEN)) != DLADM_STATUS_OK) {
+static boolean_t
+lldp_add_member(lldp_dl_walk_t *walk, datalink_id_t id)
+{
+	if (walk->ldw_nmembers == walk->ldw_alloc) {
+		uint_t nalloc = walk->ldw_alloc == 0 ? 8 : walk->ldw_alloc * 2;
+		datalink_id_t *ids = realloc(walk->ldw_members,
+		    nalloc * sizeof (datalink_id_t));
+
+		if (ids == NULL)
+			return (B_FALSE);
+
+		walk->ldw_members = ids;
+		walk->ldw_alloc = nalloc;
+	}
+
+	walk->ldw_members[walk->ldw_nmembers++] = id;
+	return (B_TRUE);
+}
+
+static boolean_t
+lldp_is_member(lldp_dl_walk_t *walk, datalink_id_t id)
+{
+	uint_t i;
+
+	for (i = 0; i < walk->ldw_nmembers; i++) {
+		if (walk->ldw_members[i] == id)
+			return (B_TRUE);
+	}
+
+	return (B_FALSE);
+}
